[Unit]
Description=Liubendou multi-device relay gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liubendou-gateway
Group=liubendou-gateway
WorkingDirectory=/opt/liubendou-gateway
ExecStart=/usr/bin/node /opt/liubendou-gateway/server.mjs
Environment=GATEWAY_PORT=8878
Environment=GATEWAY_DATA_DIR=/var/lib/liubendou-gateway
Environment=GATEWAY_PUBLIC_ORIGIN=http://leenzhuanjieben.shop
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/liubendou-gateway
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
