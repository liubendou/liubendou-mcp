# hy-memory.env —— Hy-Memory sidecar 环境配置模板（无真实密钥）
# 用法：填好后放在 v2 根目录；sidecar 启动时读取。密钥永远不进聊天/日志/交接文档。
# 模式（D1 决策：只用 lite = 仅 Embedding，不配 LLM）
MEMORY_MODE=lite
# Embedding 端点（未提供时用 tools/mock-embed-server.js 做评估）
MEMORY_EMBEDDER_BASE_URL=
MEMORY_EMBEDDER_API_KEY=
MEMORY_EMBEDDER_MODEL=
# LLM（pro/ultra 才需要；后续再说）
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=
